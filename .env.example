# ============================================================
# Hospital Knowledge Assistant — Environment Variables
# ============================================================
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.

# ------------------------------------------------------------
# OpenAI
# ------------------------------------------------------------
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Model parameters
OPENAI_TEMPERATURE=0.0
OPENAI_MAX_TOKENS=1024
OPENAI_TOP_P=1.0

# ------------------------------------------------------------
# ChromaDB
# ------------------------------------------------------------
# Leave CHROMA_HOST empty to use local persistent storage
CHROMA_HOST=
CHROMA_PORT=8000
CHROMA_COLLECTION_NAME=hospital_knowledge_base
CHROMA_DATA_DIR=./chroma_data

# ------------------------------------------------------------
# Retrieval
# ------------------------------------------------------------
TOP_K=10
SIMILARITY_THRESHOLD=0.3
RERANK_TOP_N=5
CHUNK_SIZE=512
CHUNK_OVERLAP=64
MAX_CONTEXT_TOKENS=6000

# ------------------------------------------------------------
# Auth / JWT
# ------------------------------------------------------------
JWT_SECRET_KEY=change-this-to-a-long-random-secret-string
JWT_ALGORITHM=HS256
JWT_EXPIRE_HOURS=8

# Comma-separated Hospital IDs with admin privileges
ADMIN_HOSPITAL_IDS=ADMIN01

# Path to hospital staff CSV
HOSPITAL_STAFF_CSV=./data/hospital_staff.csv

# Documents directory
DOCUMENTS_DIR=./data/documents

# ------------------------------------------------------------
# Application
# ------------------------------------------------------------
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=INFO

# ------------------------------------------------------------
# Frontend (Next.js)
# ------------------------------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:8000
